        <PackageReference Include="MoonSharp" Version="3.0.0-beta.1" />
        <PackageReference Include="Scalar.AspNetCore" Version="2.16.18"/>
        <PackageReference Include="Scalar.AspNetCore.Microsoft" Version="2.16.18"/>
